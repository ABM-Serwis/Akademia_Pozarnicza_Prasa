<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <GVL Name="GVL_ForceMode" Id="{6079d90b-4942-49f6-a517-d94f7a19eb14}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
(* ===== Zakres tensometru =====
	   Ciśnienie i siła pracują jednocześnie. Przełącznika trybu nie ma.
	   bForceRange100t:   FALSE = tensometr 50 t  (2,5 V = 50 t)
	                      TRUE  = tensometr 100 t (2,5 V = 100 t)
	   Domyślnie FALSE, więc po wgraniu zostaje zakres 50 t.
	*)
	bForceRange100t				: BOOL := FALSE;

	
	(* ===== Pomiar =====
	   Powiąż nForceInput_V z kanałem AI 0–10 V. Jednostka: wolty (0.0 … 10.0).
	   Zakres roboczy przetwornika to 0.0 … 2.5 V. Powyżej 2.55 V = błąd zakresu.
	*)
	nForceInput_V				: REAL := 0.0;

	nForce_t					: REAL;	(* wartość chwilowa, t *)
	nForce_kg					: REAL;	(* kgf *)
	nForce_N					: REAL;
	nForce_kN					: REAL;
	nForce_pct					: REAL;	(* % wybranego zakresu *)
	nForceFullScale_t			: REAL;	(* 50 albo 100 *)
	bForceSensorOk				: BOOL;
	bForceOverrange				: BOOL;
	bForceUnderrange			: BOOL;

	nForce_Target				: REAL;	(* bieżące zadanie siły [t]; 0 = limit siły wyłączony *)

	(* Zatrzask w chwili wykrycia przebicia — pomiar z tensometru, niezależnie od trybu. *)
	nForce_t_Break				: REAL;
	nForce_kg_Break				: REAL;
	nForce_N_Break				: REAL;
	nForce_kN_Break				: REAL;

	(* Setpointy faktycznie podane do regulatora po obcięciu do zakresu. *)
	nForceSetpointManual_Eff	: REAL;
	nForceSetpointAutoMin_Eff	: REAL;
	nForceSetpointAutoMax_Eff	: REAL;
	nBreakDeltaForce_Eff		: REAL;
	bForceSetpointLimited		: BOOL;	(* wpisana wartość była poza 0 … pełny zakres albo delta < 0 *)
	bForceCfgFault				: BOOL;	(* AutoMin > AutoMax po obcięciu *)
	bForceInhibit				: BOOL;	(* zły tensometr — limit siły i przebicie od siły są wyłączone, ciśnienie pracuje *)
	bMotionHold					: BOOL;	(* zmiana zakresu 50/100 t w ruchu — puść przyciski *)
	bRegulatorActive			: BOOL;
	bAlarm						: BOOL;	(* przebicie, zły tensometr albo auto min > auto max *)
	bPrzebicieUzbrojone			: BOOL;	(* TRUE gdy ruch w górę trwa i minęło tOpoznieniePrzebicia *)
	nActiveSetpointManual		: REAL;	(* ręczna nastawa ciśnienia [bar] — to idzie na zawór *)
	nActiveActual				: REAL;	(* ciśnienie rzeczywiste [bar] *)
	tCzasSprawdzania: INT;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>