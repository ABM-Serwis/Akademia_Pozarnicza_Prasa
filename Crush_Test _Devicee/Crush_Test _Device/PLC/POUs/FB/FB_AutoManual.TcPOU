<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AutoManual" Id="{9e34c28e-067b-43ff-9006-d52ce80f0048}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AutoManual
VAR_INPUT
    bControlOn   : BOOL;   // sterownik włączony
    bEstopOK     : BOOL;   // bezpieczeństwo OK
    bMoveUp      : BOOL;   // ręczny ruch w górę
    bMoveDown    : BOOL;   // ręczny ruch w dół
    bCycleStart  : BOOL;   // start trybu auto
    bCycleStop   : BOOL;   // stop / powrót do manual
    tAutoDelay   : TIME := T#2S;   // opóźnienie wyjścia w AUTO
END_VAR

VAR_OUTPUT
    bManualMode  : BOOL;   // aktualnie MANUAL
    bAutoMode    : BOOL;   // aktualnie AUTO
    bAutoDelayed : BOOL;   // wyjście załączane z opóźnieniem po wejściu w AUTO
END_VAR

VAR
    eMode        : E_Mode := Mode_Manual;

    // detekcja zboczy
    rStart       : R_TRIG;
    rStop        : R_TRIG;
    rMoveUp      : R_TRIG;
    rMoveDown    : R_TRIG;

    // timer opóźniający wyjście w AUTO
    tonAutoDelay : TON;

    bDelayIn     : BOOL;
	//Mode_Manual: E_Mode;
	//Mode_Auto: E_Mode;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ------------------------------------------------------------
// Główna logika
// ------------------------------------------------------------
bDelayIn := FALSE;  // domyślnie timer nieaktywny w tej cyklicznej iteracji

// 1. Jeśli sterowanie wyłączone lub E-STOP nie OK → zawsze MANUAL
IF NOT bControlOn OR NOT bEstopOK THEN
    eMode := Mode_Manual;
ELSE
    // 2. Detekcja zboczy przycisków
    rStart(CLK := bCycleStart);
    rStop(CLK  := NOT bCycleStop);
    rMoveUp(CLK   := bMoveUp);
    rMoveDown(CLK := bMoveDown);

    // 3. Maszyna stanów MANUAL / AUTO
    CASE eMode OF

        // ---------------- MANUAL ----------------
        0:
            // przejście do AUTO tylko na zboczu bCycleStart
            IF rStart.Q THEN
                eMode := Mode_Auto;
            END_IF;

        // ---------------- AUTO ------------------
        1:
            // każde z tych zdarzeń wraca do MANUAL:
            // - CycleStop
            // - ręczny ruch (MoveUp / MoveDown)
            // - (opcjonalnie rozbudujesz o inne warunki)
            IF rStop.Q OR rMoveUp.Q OR rMoveDown.Q THEN
                eMode := Mode_Manual;
            ELSE
                // w AUTO włączamy opóźnienie (timer)
                bDelayIn := TRUE;
            END_IF;

    END_CASE;
END_IF;

// 4. Ustawienie sygnałów trybu
bAutoMode   := (eMode = Mode_Auto);
bManualMode := NOT bAutoMode;

// 5. Obsługa timera opóźnienia wyjścia w AUTO
tonAutoDelay(
    IN := bDelayIn AND bAutoMode,  // timer działa tylko, gdy jesteśmy w AUTO
    PT := tAutoDelay
);

// wyjście opóźnione – tylko w AUTO
bAutoDelayed := tonAutoDelay.Q AND bAutoMode;]]></ST>
    </Implementation>
    <LineIds Name="FB_AutoManual">
      <LineId Id="40" Count="51" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>